# Off-site backup target — copy to deploy/backup.env on the server and fill in.
# deploy/backup.env is git-ignored, which is what keeps it alive: the deploy does
# `git reset --hard <sha>`, so anything tracked is overwritten on every release
# and anything ignored survives. Scripts belong in the repo; this belongs here.

# Hetzner Storage Box sub-account (Storage Box → Sub-accounts → create one with
# SSH enabled, "Read/Write", and its own directory). BX11 is 1 TB.
BACKUP_REMOTE=u123456-sub1@u123456.your-storagebox.de

# Directory inside the sub-account's home. Created on first push.
BACKUP_REMOTE_DIR=key-api-bot

# Storage Box listens for SSH/rsync/sftp on port 23, not 22.
BACKUP_SSH_PORT=23

# Key whose public half was uploaded to the sub-account. Passphrase-less, so
# cron can use it unattended — the sub-account is scoped to this one directory.
BACKUP_SSH_KEY=/root/.ssh/storagebox_ed25519

# How many archives to keep off-site. deploy/daily_offsite.sh ships one a night,
# so 30 is a month. Each is ~8 MB: a year would be under half a gigabyte. Be
# generous — the retention that costs disk is the one on this machine, not the
# one over there.
BACKUP_RETAIN=30

# Passphrase file for the encrypted copy of .env that rides along in the
# archive. Without it the data ships and the config does not, and a restore
# gives you a warehouse that nothing can start against — the host's .env and
# the laptop's have already drifted apart, so neither is a complete source.
# Create it with `head -c 32 /dev/urandom | base64 > /root/.backup_pass`,
# chmod 600, and keep a copy of the passphrase somewhere that is not this box.
BACKUP_ENV_PASSFILE=/root/.backup_pass

# Refuse to ship an export older than this many days. The export is written by
# the weekly compact, so anything past ~8 days means the compact stopped and
# the archive would be stale data under a fresh filename.
BACKUP_MAX_EXPORT_AGE_DAYS=8

# ── Postgres off-site (deploy/pg_offsite.sh, DN-09) ──────────────────────────
# The dumps are the only copy of app.order_versions, app.stock_movements, the
# dashboard access list and the SMS roster, and until this existed not one of
# them left the machine. Everything below has a working default; BACKUP_REMOTE
# and BACKUP_ENV_PASSFILE above are what the shipper actually requires, and it
# refuses without either — OD-01 (b) made the encryption mandatory, because
# these files carry customer phone numbers and the box is the same provider as
# the VPS.
#
# Directory inside the sub-account, beside the Parquet archive rather than in
# it: two retentions that can never see each other's filenames.
# BACKUP_PG_REMOTE_DIR=key-api-bot/postgres
#
# How many shipments to keep off-site, by COUNT. Never by age — deleting the
# oldest by date is how a recovery point stops existing on exactly the week
# the maker was broken. Fourteen matches what pg_backup.sh keeps locally.
# BACKUP_PG_RETAIN=14
#
# Refuse to ship a dump older than this. pg_backup runs daily at 06:50, so 30h
# is one missed run plus slack; past it the dump is stale and shipping it
# would move the freshness marker and silence the alarm below.
# BACKUP_PG_MAX_DUMP_AGE_HOURS=30
#
# The marker deploy/offsite_check.sh reads, and how old it may be before that
# check alerts. Written only after the uploaded bytes have been fetched back
# and their sha256 compared.
# BACKUP_PG_MARKER=data/.pg_offsite_last_ok
# BACKUP_PG_MAX_ARCHIVE_AGE_HOURS=36
#
# Where a run writes what it did, and the bound on that file. It is trimmed by
# the shipper itself on every run, so nothing outside has to remember to.
# BACKUP_PG_OFFSITE_LOG=data/logs/pg_offsite.log
# BACKUP_PG_OFFSITE_LOG_LINES=2000
#
# One run at a time. flock holds this; a second cron firing while a slow
# upload is still verifying finds it held and stands down quietly.
# BACKUP_PG_LOCK=data/.pg_offsite.lock
#
# Which transport carries the copy. Only `sftp` exists today; OD-01 (c), a
# second provider, becomes a second value here and changes nothing else.
# BACKUP_PG_REMOTE_KIND=sftp

# Who gets the Telegram alert. Optional: with this unset the scripts message the
# first id in ADMIN_USER_IDS from .env, i.e. the main admin. BOT_TOKEN is read
# from .env too, so it is not duplicated here.
# BACKUP_ALERT_CHAT_ID=
