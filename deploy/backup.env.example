# Off-site backup target — copy to deploy/backup.env on the server and fill in.
# deploy/backup.env is git-ignored, which is what keeps it alive: the deploy does
# `git reset --hard <sha>`, so anything tracked is overwritten on every release
# and anything ignored survives. Scripts belong in the repo; this belongs here.

# Hetzner Storage Box sub-account (Storage Box → Sub-accounts → create one with
# SSH enabled, "Read/Write", and its own directory). BX11 is 1 TB.
BACKUP_REMOTE=u123456-sub1@u123456.your-storagebox.de

# Directory inside the sub-account's home. Created on first push.
BACKUP_REMOTE_DIR=key-api-bot

# Storage Box listens for SSH/rsync/sftp on port 23, not 22.
BACKUP_SSH_PORT=23

# Key whose public half was uploaded to the sub-account. Passphrase-less, so
# cron can use it unattended — the sub-account is scoped to this one directory.
BACKUP_SSH_KEY=/root/.ssh/storagebox_ed25519

# How many weekly archives to keep off-site. Each is ~8 MB, so this is close to
# free: 8 is two months, 52 would be a year for under half a gigabyte. The
# retention that costs disk is the one on this machine, not the one over there.
BACKUP_RETAIN=8

# Passphrase file for the encrypted copy of .env that rides along in the
# archive. Without it the data ships and the config does not, and a restore
# gives you a warehouse that nothing can start against — the host's .env and
# the laptop's have already drifted apart, so neither is a complete source.
# Create it with `head -c 32 /dev/urandom | base64 > /root/.backup_pass`,
# chmod 600, and keep a copy of the passphrase somewhere that is not this box.
BACKUP_ENV_PASSFILE=/root/.backup_pass

# Refuse to ship an export older than this many days. The export is written by
# the weekly compact, so anything past ~8 days means the compact stopped and
# the archive would be stale data under a fresh filename.
BACKUP_MAX_EXPORT_AGE_DAYS=8

# Who gets the Telegram alert. Optional: with this unset the scripts message the
# first id in ADMIN_USER_IDS from .env, i.e. the main admin. BOT_TOKEN is read
# from .env too, so it is not duplicated here.
# BACKUP_ALERT_CHAT_ID=
